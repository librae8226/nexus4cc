# =============================================================
# Nexus 配置文件
# 使用方法: cp .env.example .env
# 默认值已填好，可直接启动。生产环境请务必修改密码和密钥。
# =============================================================

# JWT 签名密钥
# ⚠️  生产环境请替换：openssl rand -hex 32
JWT_SECRET=fcea4c5c28bee4c9fa7adca25c947f87b2a7179202c824d185618d3b3bf2a333

# 登录密码的 bcrypt hash
# 默认密码: nexus123
# ⚠️  生产环境请替换（生成新 hash）:
#   node -e "const b=require('bcrypt');b.hash('yourpassword',12).then(h=>console.log(h))"
ACC_PASSWORD_HASH=$2b$12$5xRyI8a3yVhcCHqYP/Pdju/mKjxtxjWihXE1VpaXCdnuM6VUVNUsW

# 要 attach 的 tmux session 名（不存在会自动创建）
TMUX_SESSION=main

# 工作区根目录（Claude 能访问的文件系统路径）
# 改为你实际的工作目录，例如 /home/yourname/work 或 /root
WORKSPACE_ROOT=/home

# 服务监听端口
PORT=59000

# 监听地址。默认 0.0.0.0 = 所有网卡（含局域网），这是历史行为。
# ⚠️ 本服务是 HTTP 明文，且 /api/configs 会明文返回 profile 里的 API token，
#    绑 0.0.0.0 意味着同网段任何设备都能访问登录页。若只经 Tailscale/VPN 使用，
#    建议改绑该虚拟网卡地址（如 100.x.y.z）或 127.0.0.1，别暴露给局域网。
HOST=0.0.0.0

# ── CORS 白名单（Android APK / 独立 origin 客户端）────────────────
# 逗号分隔的来源白名单。留空 = 不发任何 CORS 头（浏览器/PWA 与改造前完全一致）。
# APK 的 WebView origin 是 http://localhost 或 https://localhost（取决于
# capacitor.config 的 androidScheme），两种都列上即可：
#   CORS_ORIGINS=http://localhost,https://localhost
# 浏览器路径永远与 server 同源，不需要、也不应该把 http://192.168.x.x:59000 之类
# 写进来 —— 那只会扩大暴露面。生产禁止通配符 *（见 CLAUDE.md 安全规约）。
CORS_ORIGINS=

# claude CLI 路径（可选）。留空则自动探测：CLAUDE_BIN > PATH 里的 claude
# > ~/.local/bin/claude > /usr/local/bin/claude > /opt/homebrew/bin/claude
# 装法不同路径就不同（官方 install.sh / npm -g 走 nvm、fnm、volta / Homebrew），
# 探测不到或想指定特定版本时在这里写绝对路径。
CLAUDE_BIN=

# Claude 启动时注入的代理（用于访问 Anthropic API，不需要则留空）
# 格式: http://host:port
CLAUDE_PROXY=

# ── 微信通道（iLink / ClawBot）──────────────────────────────────
# 由独立进程 channels/wechat-worker.mjs 使用，server.js 不读这些变量。
# 实际取值在 ecosystem.config.cjs 的 nexus-wechat 应用里配置。
# 凭证不在这里 —— 扫码后自动落到 data/channels/wechat.json（0600，已 gitignore）。

# 使用的 profile id（对应 data/configs/<id>.json）
WECHAT_PROFILE=deepseek

# agent 的工作目录。注意：这只是默认工作位置，不是沙箱 ——
# 权限为 full 时 agent 可以访问任意路径。
WECHAT_WORKDIR=

# 白名单，逗号分隔的 ilink_user_id。留空则用扫码者本人。
# ⚠️ 为空会拒绝启动：该通道等价于把本机 shell 暴露到微信。
WECHAT_ALLOW_FROM=

# 工具权限：full（默认，--dangerously-skip-permissions）| safe（只读+检索）
WECHAT_PERMISSION=full

# GitHub 仓库（用于检查更新），格式: owner/repo
# Fork 用户改为自己的 repo
GITHUB_REPO=librae8226/nexus4cc
