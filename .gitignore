
# Claude Code persistence
.claude-data/

# Superpowers workspace
.superpowers/
docs/superpowers/

# Sensitive scripts for reference only
.scripts/

# Environment (contains secrets)
.env

# Dependencies
node_modules/
frontend/node_modules/

# Build output
frontend/dist/

# E2E tests and screenshots (dev artifacts)
e2e-*.cjs
e2e-screenshots/
screenshots/
*.pdf

# PM2
ecosystem.config.cjs

# Android (Capacitor shell) — 只提交源码与配置，其余全是可再生产物
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/local.properties
android/keystore/
android/keystore.properties
android/.idea/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
*.jks
*.keystore
!android/app/debug.keystore

# Runtime data (tasks, session configs)
# Ignore everything under data/, except the default anthropic profile (no secrets)
data/*
!data/configs/
data/configs/*
!data/configs/anthropic.json
logs/

# Local scratch files (whiteboard mermaid sources, temp docs)
.wb-*.mmd
nexus-tech-report-wb.md
.blackboard/

# Gradle 缓存（约 1-2GB，容器构建用）
android/.gradle-home/

# 构建出的 APK（便于取用，非源码）
android/dist/

# Python 字节码缓存（channels/local-asr.py 等）
__pycache__/
*.pyc
